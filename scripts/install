#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESOLVE CURATED IMAGE
#=================================================
# Turn the selected key (e.g. "nginx") into a pinned, vetted free-software
# image reference, its license and its internal port. Dies if the key is not
# on the allowlist in _common.sh.
resolve_curated_image "$image"

# Reject Moodle on a 32-bit host before pulling (the pinned image is 64-bit only).
moodle_arch_guard "$image"

#=================================================
# GRANT APP USER ACCESS TO DOCKER
#=================================================
ynh_script_progression "Configuring system user..."

usermod -aG docker "$app"

#=================================================
# ENSURE DOCKER IS AVAILABLE
#=================================================
ynh_script_progression "Checking Docker availability..."

if ! command -v docker &>/dev/null; then
    ynh_die "Docker is not installed. Please install docker.io before using this app."
fi

if ! ynh_systemctl --service="docker" --action="is-active" &>/dev/null; then
    ynh_script_progression "Starting Docker daemon..."
    ynh_systemctl --service="docker" --action="start"
fi

#=================================================
# PULL DOCKER IMAGE
#=================================================
ynh_script_progression "Pulling Docker image $image_ref..."

pull_success=false
for attempt in 1 2 3; do
    if docker pull "$image_ref" 2>&1; then
        pull_success=true
        break
    fi

    if [ $attempt -lt 3 ]; then
        ynh_print_warn "Pull attempt $attempt failed. Retrying in 5 seconds..."
        sleep 5
    fi
done

if [ "$pull_success" = false ]; then
    ynh_die "Failed to pull Docker image '$image_ref' after 3 attempts."
fi

#=================================================
# COMPUTE DOCKER RUN CONFIGURATION
#=================================================
ynh_script_progression "Computing container configuration..."

#=================================================
# MOODLE HARDENING (persistence + admin credentials)
#=================================================
if is_moodle_image "$image"; then
    # Moodle stores uploads/plugins/config outside the container's writable layer,
    # which conf/systemd.service discards on every stop — persistence is mandatory.
    if [ "$use_data_volume" -ne 1 ]; then
        ynh_die "Moodle requires the persistent data volume. Re-install with 'Mount a persistent data directory' enabled; otherwise uploads, installed plugins and configuration are lost on the first restart or upgrade."
    fi

    ynh_script_progression "Preparing Moodle persistent storage..."
    prepare_moodle_state_dirs "$data_dir"

    # The image ships a well-known default admin (moodleuser / PLEASE_CHANGEME).
    # Unless the admin supplied their own MOODLE_PASSWORD in docker_options,
    # generate one so a fresh instance is not trivially takeover-able.
    if [[ "$docker_options" != *MOODLE_PASSWORD* ]]; then
        if [ -z "${moodle_password:-}" ]; then
            moodle_password="$(ynh_string_random --length=24)"
        fi
        docker_options="-e MOODLE_USERNAME=admin -e MOODLE_PASSWORD=${moodle_password} ${docker_options}"
        ynh_app_setting_set --key=docker_options --value="$docker_options"
        ynh_app_setting_set --key=moodle_admin_user --value="admin"
        ynh_app_setting_set --key=moodle_password --value="$moodle_password"
    fi
fi

compute_docker_config "$restart_policy" "$use_data_volume" "$data_dir" "$docker_network" "$image"

ynh_app_setting_set --key=image_ref --value="$image_ref"
ynh_app_setting_set --key=image_license --value="$image_license"
ynh_app_setting_set --key=container_port --value="$container_port"
ynh_app_setting_set --key=docker_restart_policy --value="$docker_restart_policy"
ynh_app_setting_set --key=docker_volume_opts --value="$docker_volume_opts"
ynh_app_setting_set --key=docker_network_opt --value="$docker_network_opt"
ynh_app_setting_set --key=docker_network --value="$docker_network"
ynh_app_setting_set --key=restart_policy --value="$restart_policy"
ynh_app_setting_set --key=use_data_volume --value="$use_data_volume"

#=================================================
# CONFIGURE NGINX
#=================================================
ynh_script_progression "Configuring NGINX web server..."

ynh_config_add_nginx

#=================================================
# CONFIGURE SYSTEMD SERVICE
#=================================================
ynh_script_progression "Configuring systemd service..."

ynh_config_add_systemd

yunohost service add "$app" \
    --description="Docker container: $image_ref ($image_license)"

#=================================================
# ENSURE DOCKER NETWORK EXISTS
#=================================================
if [ -n "$docker_network" ]; then
    ynh_script_progression "Ensuring Docker network '$docker_network' exists..."
    docker network create "$docker_network" 2>/dev/null || ynh_print_info "Network '$docker_network' already exists"
fi

#=================================================
# START SERVICE
#=================================================
ynh_script_progression "Starting Docker container..."

ynh_systemctl --service="$app" --action="start"

if ! wait_for_port "$port" 60; then
    ynh_print_warn "Container did not bind to port $port within 60 seconds."
    ynh_print_warn "Some images (especially docker-compose) take longer to start."
    ynh_print_warn "Container may still be initializing. Check status with:"
    ynh_print_warn "  systemctl status $app"
    ynh_print_warn "  journalctl -u $app -n 50"
fi

#=================================================
# VERIFY DOCKER NETWORK ATTACHMENT
#=================================================
if [ -n "$docker_network" ]; then
    ynh_script_progression "Verifying Docker network attachment..."
    container_id=$(docker inspect -f '{{.Id}}' "$app" 2>/dev/null | head -c 12)
    if [ -n "$container_id" ]; then
        if ! docker network inspect "$docker_network" | grep -q "$container_id"; then
            ynh_print_warn "Container not on network '$docker_network'. Connecting..."
            docker network connect "$docker_network" "$app" 2>/dev/null || true
        fi
    fi
fi

#=================================================
# REPORT MOODLE ADMIN CREDENTIALS
#=================================================
if is_moodle_image "$image" && [ -n "${moodle_password:-}" ]; then
    ynh_print_info "Moodle admin account is 'admin'. Retrieve the generated password with: yunohost app setting $app moodle_password"
fi

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
